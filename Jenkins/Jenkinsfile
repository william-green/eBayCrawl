pipeline {
    agent any

    environment {
        // Define your Docker image name for the scraper
        SCRAPER_IMAGE = "ebay-scraper-prod"
    }

    stages {
        stage('Setup Environment') {
            steps {
                echo 'Preparing Python Virtual Environment...'
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                    pip install flake8 pytest
                '''
            }
        }

        stage('Static Analysis (Linting)') {
            steps {
                echo 'Running Flake8 for PEP8 Compliance...'
                // Run flake8 and save output for the Warnings Next Gen plugin
                sh '''
                    . venv/bin/activate
                    flake8 . --format=default --output-file=flake8-warnings.txt || true
                '''
                // This step triggers the visualization plugin you installed
                recordIssues(tools: [flake8(pattern: 'flake8-warnings.txt')])
            }
        }

        stage('Unit & Mock Testing') {
            steps {
                echo 'Executing PyTest with Mocks...'
                sh '''
                    . venv/bin/activate
                    pytest tests/ --junitxml=results.xml
                '''
            }
            post {
                always {
                    // Archives test results so Jenkins can show the "Weather Report"
                    junit 'results.xml'
                }
            }
        }

        stage('Build Scraper Image') {
            steps {
                echo 'Packaging Scraper into Docker Container...'
                // This uses the host's Docker engine via the socket we mounted
                sh "docker build -t ${SCRAPER_IMAGE}:${env.BUILD_ID} ."
            }
        }
    }

    post {
        success {
            echo 'Pipeline Passed: eBay Scraper is ready for deployment.'
        }
        failure {
            echo 'Pipeline Failed: Review linting or test results.'
        }
    }
}